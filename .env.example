OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SOURCE_MANAGEMENT_ENABLED=false

# Optional shared-password gate for a hosted demo. Set the password privately.
DEMO_ACCESS_ENABLED=false
DEMO_PASSWORD=

# Optional prepared-seed recovery. Leave the path empty for the normal local workflow.
RAG_INDEX_BOOTSTRAP_SEED_PATH=
RAG_INDEX_VECTOR_DIMENSIONS=1536

# Optional UI index-build override. Empty inherits local source-management setting.
# On a read-only demo, true allows only explicit reuse-only rebuilding.
RAG_INDEX_BUILD_ENABLED=
